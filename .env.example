# Set these in Vercel Project Settings > Environment Variables.
# This cosmetic gate is compiled into the static client bundle.
DEVELOPER_GATE_USERNAME=dhawalshankarshukla
DEVELOPER_GATE_PASSWORD=replace-with-a-casual-gate-password

# Sarvam AI API Configuration for Varta Docs Agent
SARVAM_API_KEY=your-sarvam-api-key-here
SARVAM_MODEL=sarvam-105b

# Official Sarvam Voice Agents (Samvaad) Embed Script URL (Optional)
# If you deploy a Voice Agent on https://indus.sarvam.ai/samvaad -> Deploy with Code -> Embed, paste the script URL or agent ID here:
SARVAM_VOICE_AGENT_SCRIPT=

